{
  "name": "quote-order-system",
  "version": "1.1.19",
  "description": "报价跟单系统",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch api/index.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p api/tsconfig.json",
    "start": "NODE_ENV=production node api/dist/index.js",
    "start:dev": "node scripts/start.js --env development",
    "start:test": "node scripts/start.js --env test",
    "start:prod": "node scripts/start.js --env production",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx api/seed.ts",
    "db:migrate": "tsx api/migrate.ts",
    "db:reset": "tsx api/reset.ts",
    "db:cleanup-history": "tsx scripts/cleanup-quote-history.ts",
    "db:cleanup-history:dry": "tsx scripts/cleanup-quote-history.ts --dry-run",
    "env:build": "bash scripts/build.sh",
    "env:start": "bash scripts/start.sh",
    "env:stop": "bash scripts/stop.sh",
    "env:restart": "bash scripts/restart.sh",
    "env:status": "bash scripts/status.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/archiver": "^8.0.0",
    "@types/multer": "^2.2.0",
    "@visactor/vtable": "^1.26.6",
    "@visactor/vtable-plugins": "^1.26.6",
    "@visactor/vtable-sheet": "^1.26.6",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.2.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.395.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.10"
  }
}
